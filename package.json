		"@tailwindcss/vite": "^4.3.2",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^24.13.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
